# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel.
ALLOWED_EMAIL=raphaelduvalle@gmail.com
GUI_EMAIL=contato@guimuniz.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=
# Endereço do site (na Vercel, ex.: https://central-raphael.vercel.app)
NEXTAUTH_URL=http://localhost:3000
# Instagram (app da Meta → "API setup with Unified login" → token de usuário do sistema, não expira)
INSTAGRAM_TOKEN=
# Opcional: id da conta do Instagram, se a detecção automática falhar
INSTAGRAM_USER_ID=
